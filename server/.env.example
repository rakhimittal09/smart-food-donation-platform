# ─────────────────────────────────────────────────────────
# Smart Food Donation Platform — Server Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────

# MongoDB Connection — Local or Atlas
# Local:  mongodb://127.0.0.1:27017/smart-food-donation
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/smart-food-donation?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/smart-food-donation

# JWT Configuration
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRE=7d

# Server Port (Render sets this automatically in production)
PORT=5000

# Environment
NODE_ENV=development

# Frontend URL (used for CORS in production)
# Example: https://smart-food-donation-frontend.onrender.com
CLIENT_URL=http://localhost:5173
